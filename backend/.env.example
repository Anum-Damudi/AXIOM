# Project Environment Configuration
PROJECT_NAME="AXIOM — NEXUS-CRIME"
API_V1_STR="/api/v1"
SECRET_KEY="axiom_nexus_crime_hackathon_super_secret_jwt_key_2026"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Database
# Default: SQLite file inside backend for instant local run/tests without requiring external Postgres setup
DATABASE_URL="sqlite:///./axiom.db"
# Production PostgreSQL URL:
# DATABASE_URL="postgresql://axiom_user:axiom_pass@localhost:5432/axiom_db"

# Neo4j Graph Database
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"

# File Upload Storage Directory
UPLOAD_DIR="./uploads"

# CORS Origins (Comma separated or json array)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]
